{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "xslt",
			"label": "xslt: Examen",
			"saxonJar": "${config:XSLT.tasks.saxonJar}",
			"xsltFile": "${workspaceFolder}/examenes/04/grupos.xsl",
			"xmlSource": "${workspaceFolder}/examenes/04/grupos.xml",
			"resultPath": "${workspaceFolder}/examenes/04/grupos.html",
			"allowSyntaxExtensions40": "off",
			"messageEscaping": "adaptive",
			"group": {
				"kind": "build"
			},
			"problemMatcher": [
				"$saxon-xslt"
			]
		}
	]
}